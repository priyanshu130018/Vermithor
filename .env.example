# Vermithor Configuration Template
# Copy this file to .env for local development overrides
# (Never commit actual passwords or private tokens to version control)

# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=vermithor

# Neon Serverless PostgreSQL & pgvector Database Settings
# Obtain your connection strings from the Neon Console (https://console.neon.tech)
# or via Neon CLI: `npx neon connection-string`
#
# Pooled connection string (recommended for application runtime / backend & worker):
# Supported formats: postgresql://, postgres://, or postgresql+psycopg:// with ?sslmode=require
DATABASE_URL=postgresql+psycopg://neondb_owner:<NEON_PASSWORD>@ep-curly-mode-b4ilila7-pooler.c-6.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require
#
# Unpooled direct connection string (required for Alembic DDL migrations):
DATABASE_URL_UNPOOLED=postgresql+psycopg://neondb_owner:<NEON_PASSWORD>@ep-curly-mode-b4ilila7.c-6.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Redis Cache & Celery Task Queue
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Backend JWT Authentication & Security Boundary (HS256)
JWT_SECRET=vermithor-dev-secret-key-32-chars-min
JWT_ISSUER=vermithor
JWT_AUDIENCE=vermithor-api

# Grafana Dashboard Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password

# Cloud Vector Embeddings (Hugging Face Inference Providers & pgvector 384-D)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HF_EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference

# LLM Synthesis & Inference Providers (Hugging Face or Local Ollama)
# Provider choices: 'huggingface' or 'ollama'
LLM_PROVIDER=ollama

# Hugging Face Inference Providers Configuration (when LLM_PROVIDER=huggingface)
# Obtain your API token from: https://huggingface.co/settings/tokens
# Check remaining credits or billing limits at: https://huggingface.co/settings/billing
# Note: Hugging Face Inference Providers router (https://router.huggingface.co/v1) requires
# pre-paid credits or a PRO subscription for chat completion models.
# When credits are exhausted, the server activates deterministic grounded fallback if LLM_FALLBACK_ENABLED=true.
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# Local Ollama Configuration (when LLM_PROVIDER=ollama)
# Install Ollama: https://ollama.com
# Pull desired model: `ollama pull llama3.2` (or `ollama pull llama3.1`, `mistral`, etc.)
# Start Ollama service: `ollama serve` (listens on port 11434 by default)
#
# Base URL for host execution (running backend directly via python):
# OLLAMA_BASE_URL=http://localhost:11434
#
# Base URL for Docker Compose execution (container accessing host Ollama instance):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Shared LLM Generation, Fallback & Output Settings
LLM_TIMEOUT_SECONDS=120
LLM_FALLBACK_ENABLED=true
MAX_OUTPUT_TOKENS=2000

# OpenTelemetry Tracing Endpoint (Jaeger OTLP HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Observability Integration Endpoints
PROMETHEUS_URL=http://localhost:9090
JAEGER_QUERY_URL=http://localhost:16686
OBSERVABILITY_REQUEST_TIMEOUT=5.0

