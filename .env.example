# Vermithor Configuration Template
# Copy this file to .env for local development overrides
# (Never commit actual passwords or private tokens to version control)

# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=vermithor

# PostgreSQL & pgvector Database Settings
POSTGRES_USER=vermithor
POSTGRES_PASSWORD=vermithor_password
POSTGRES_DB=vermithor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vermithor:vermithor_password@localhost:5432/vermithor

# Redis Cache & Celery Task Queue
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Gateway JWT Security Boundary (HS256)
JWT_SECRET=vermithor-dev-secret-key-32-chars-min
JWT_ISSUER=vermithor
JWT_AUDIENCE=vermithor-api

# Frontend Development JWT Security Defaults
VITE_JWT_SECRET=vermithor-dev-secret-key-32-chars-min
VITE_JWT_ISSUER=vermithor
VITE_JWT_AUDIENCE=vermithor-api

# Grafana Dashboard Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password

# LLM Synthesis & Local Inference (Ollama)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# OpenTelemetry Tracing Endpoint (Jaeger OTLP HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
